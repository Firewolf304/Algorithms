{
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/my_mount", // Точка монтирования
                "--fs-name", "vscode_debug_fs",
                "--allow-other"
            ],
        }
    ]
}